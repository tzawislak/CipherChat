qmake: FORCE
	@$(QMAKE) -spec linux-g++-64 -o Makefile ../communicator/communicator.pro

qmake_all: FORCE


all: Makefile $(TARGET)

dist: distdir FORCE
	(cd `dirname $(DISTDIR)` && $(TAR) $(DISTNAME).tar $(DISTNAME) && $(COMPRESS) $(DISTNAME).tar) && $(MOVE) `dirname $(DISTDIR)`/$(DISTNAME).tar.gz . && $(DEL_FILE) -r $(DISTDIR)

distdir: FORCE
	@test -d $(DISTDIR) || mkdir -p $(DISTDIR)
	$(COPY_FILE) --parents $(DIST) $(DISTDIR)/
	$(COPY_FILE) --parents ../communicator/head/mainwindow.h ../communicator/head/setpassworddialog.h ../communicator/head/cryptography.h ../communicator/head/newcontactdialog.h ../communicator/head/tcpconnector.h ../communicator/head/checkpassworddialog.h $(DISTDIR)/
	$(COPY_FILE) --parents ../communicator/src/main.cpp ../communicator/src/mainwindow.cpp ../communicator/src/setpassworddialog.cpp ../communicator/src/cryptography.cpp ../communicator/src/newcontactdialog.cpp ../communicator/src/tcpconnector.cpp ../communicator/src/checkpassworddialog.cpp $(DISTDIR)/
	$(COPY_FILE) --parents ../communicator/ui/mainwindow.ui ../communicator/ui/setpassworddialog.ui ../communicator/ui/newcontactdialog.ui ../communicator/ui/checkpassworddialog.ui $(DISTDIR)/


clean: compiler_clean 
	-$(DEL_FILE) $(OBJECTS)
	-$(DEL_FILE) *~ core *.core


distclean: clean 
	-$(DEL_FILE) $(TARGET) 
	-$(DEL_FILE) Makefile


