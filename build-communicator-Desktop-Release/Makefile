####### Compile

main.o: ../communicator/src/main.cpp ../communicator/head/mainwindow.h \
		../communicator/head/tcpconnector.h \
		../communicator/head/setpassworddialog.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o main.o ../communicator/src/main.cpp

mainwindow.o: ../communicator/src/mainwindow.cpp ../communicator/head/mainwindow.h \
		../communicator/head/tcpconnector.h \
		../communicator/head/setpassworddialog.h \
		../communicator/head/newcontactdialog.h \
		ui_mainwindow.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o mainwindow.o ../communicator/src/mainwindow.cpp

setpassworddialog.o: ../communicator/src/setpassworddialog.cpp ../communicator/head/setpassworddialog.h \
		ui_setpassworddialog.h \
		../communicator/head/cryptography.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o setpassworddialog.o ../communicator/src/setpassworddialog.cpp

cryptography.o: ../communicator/src/cryptography.cpp ../communicator/head/cryptography.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o cryptography.o ../communicator/src/cryptography.cpp

newcontactdialog.o: ../communicator/src/newcontactdialog.cpp ../communicator/head/newcontactdialog.h \
		ui_newcontactdialog.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o newcontactdialog.o ../communicator/src/newcontactdialog.cpp

tcpconnector.o: ../communicator/src/tcpconnector.cpp ../communicator/head/tcpconnector.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o tcpconnector.o ../communicator/src/tcpconnector.cpp

checkpassworddialog.o: ../communicator/src/checkpassworddialog.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o checkpassworddialog.o ../communicator/src/checkpassworddialog.cpp

moc_mainwindow.o: moc_mainwindow.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o moc_mainwindow.o moc_mainwindow.cpp

moc_setpassworddialog.o: moc_setpassworddialog.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o moc_setpassworddialog.o moc_setpassworddialog.cpp

moc_newcontactdialog.o: moc_newcontactdialog.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o moc_newcontactdialog.o moc_newcontactdialog.cpp

moc_checkpassworddialog.o: moc_checkpassworddialog.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o moc_checkpassworddialog.o moc_checkpassworddialog.cpp

